generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
  NONE
}

enum CommunicationPreference {
  CHAT_ONLY
  CHAT_AND_CALL
}

enum ActivityStatus {
  ACTIVE
  AWAY
  INACTIVE
}

enum CoachAvailability {
  AVAILABLE
  UNAVAILABLE
}

enum TimeSlotStatus {
  AVAILABLE
  BOOKED
  UNAVAILABLE
}

enum UserRole {
  USER
  ADMIN
}

enum LessonType {
  LESSON
}

enum LessonRequestStatus {
  PENDING
  ACCEPTED
  IN_PROGRESS
  DECLINED
  EXPIRED
  COMPLETED
  CANCELLED
  DISPUTED
  NO_SHOW
}

enum LessonCommunicationMethod {
  CALL
  CHAT
}

enum TransactionType {
  DEPOSIT
  LESSON_PAYMENT
  LESSON_REFUND
  PAYOUT
}

enum PayoutStatus {
  PENDING
  COMPLETED
  FAILED
}

enum AbuseFlagType {
  DUPLICATE_CARD
  CONFIRMATION_TIMEOUT
  ONE_SIDED_CONFIRMATION
  COACH_NON_RESPONSIVE
  STUDENT_SPAM
  MULTI_ACCOUNT_SUSPECTED
  LESSON_DISPUTE
  COACH_NO_SHOW
  STUDENT_NO_SHOW
  MESSAGE_ABUSE
}

enum AbuseFlagSeverity {
  LOW
  MEDIUM
  HIGH
}

enum VerificationTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum NotificationType {
  LESSON_REQUESTED
  LESSON_ACCEPTED
  LESSON_DECLINED
  LESSON_CANCELLED
  LESSON_DISPUTED
  LESSON_COMPLETED
  COACH_NO_SHOW
  STUDENT_NO_SHOW
  REVIEW_RECEIVED
  COACH_UNAVAILABLE
  NEW_MESSAGE
}

model User {
  id            String   @id @default(cuid())
  username      String?  @unique
  email         String   @unique
  passwordHash  String?
  emailVerified DateTime?
  image         String?
  // True once the user uploads their own photo: locks `image` so the chess.com
  // avatar sync can never overwrite a picture they chose themselves.
  customAvatar  Boolean  @default(false)
  role          UserRole @default(USER)

  // Chess.com verification
  chessComUsername    String?  @unique
  verificationStatus VerificationStatus @default(NONE)
  verificationCode   String?  // auto-verification code for chess.com location

  // Profile info
  chessRating           Int?
  coachChatPrice        Int?      // cents per 30-min slot (chat)
  coachCallPrice        Int?      // cents per 30-min slot (call)
  communicationPreference CommunicationPreference @default(CHAT_ONLY)
  chessComAccountAge    DateTime? // when the chess.com account was created
  bio                   String?
  timezone              String?   // IANA timezone (e.g., "Europe/London")
  languages             String[]  @default([]) // ISO 639-1 codes (e.g., ["en", "es"])

  // Stats
  lessonsGiven   Int @default(0)
  lessonsTaken   Int @default(0)
  playersTaught  Int @default(0)

  // Wallet & earnings
  walletBalance      Int @default(0) // cents (student balance)
  reservedBalance    Int @default(0) // cents (held for pending lessons)
  pendingEarnings    Int @default(0) // cents (coach earnings awaiting payout)
  totalEarningsAllTime Int @default(0) // cents

  // Coach ELO
  coachElo           Float @default(1000)
  coachRatingPenalty Float @default(0) // penalty for no-shows etc.

  // Coaching availability
  coachAvailability CoachAvailability @default(AVAILABLE)

  // Free trials
  freeTrialsRemaining Int @default(3)

  // Coach toggle: whether they currently accept new free-trial requests.
  // Defaults true (and only unlockable to false once they've carried out a
  // trial) so new coaches always stay reachable for their first booking.
  acceptingFreeTrials Boolean @default(true)

  // Admin override: lets a coach receive paid bookings without the
  // carried-out-free-trial requirement (e.g. a coach the admin vouches for).
  paidBookingsApproved Boolean @default(false)

  // Suspension
  isSuspended Boolean @default(false)

  // Disputes
  hasActiveDispute Boolean @default(false)

  // Signup IP (for multi-account detection)
  signupIp String?

  // Activity
  lastActiveAt   DateTime @default(now())
  activityStatus ActivityStatus @default(ACTIVE)

  // Stripe
  stripeCustomerId       String?
  stripeConnectAccountId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  accounts          Account[]
  reviewsGiven      Review[]        @relation("ReviewFrom")
  reviewsReceived   Review[]        @relation("ReviewTo")
  lessonRequestsAsStudent LessonRequest[] @relation("Student")
  lessonRequestsAsCoach   LessonRequest[] @relation("Coach")
  transactions      Transaction[]
  payouts           Payout[]
  earningRecords    EarningRecord[]
  cardFingerprints  CardFingerprint[]
  abuseFlags        AbuseFlag[]     @relation("FlaggedUser")
  abuseFlagsRelated AbuseFlag[]     @relation("RelatedUser")
  favourites        Favourite[]     @relation("FavouriteUser")
  favouritedBy      Favourite[]     @relation("FavouriteCoach")
  blocksGiven       Block[]         @relation("Blocker")
  blocksReceived    Block[]         @relation("Blocked")
  timeSlotTemplates TimeSlotTemplate[]
  timeSlots         TimeSlot[]
  chatMessagesSent  ChatMessage[]
  verificationTokens VerificationToken[]
  notifications     Notification[]
  conversationsA         Conversation[]  @relation("ConvA")
  conversationsB         Conversation[]  @relation("ConvB")
  directMessagesSent     DirectMessage[] @relation("DMSender")
  puzzleSolves           PuzzleSolve[]

  @@index([coachElo(sort: Desc)])
  @@index([lastActiveAt])
  @@index([activityStatus])
  @@index([verificationStatus])
  @@index([languages], type: Gin)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Review {
  id        String   @id @default(cuid())
  rating    Int      // 1-5
  comment   String?
  
  fromUserId String
  fromUser   User   @relation("ReviewFrom", fields: [fromUserId], references: [id])
  
  toUserId   String
  toUser     User   @relation("ReviewTo", fields: [toUserId], references: [id])
  
  lessonId   String
  lesson     LessonRequest @relation(fields: [lessonId], references: [id])
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  @@unique([fromUserId, lessonId]) // one review per user per lesson
  @@index([toUserId])
}

model LessonRequest {
  id        String   @id @default(cuid())
  
  studentId String
  student   User   @relation("Student", fields: [studentId], references: [id])
  
  coachId   String
  coach     User   @relation("Coach", fields: [coachId], references: [id])
  
  type            LessonType
  durationMinutes Int            @default(30) // always 30 for timeslot system (LESSON_DURATION_MINUTES)
  estimatedCost   Int            // cents
  isTrial         Boolean        @default(false)
  communicationMethod LessonCommunicationMethod?
  message         String?
  
  // Timeslot scheduling
  timeSlotId        String?
  timeSlot          TimeSlot?  @relation(fields: [timeSlotId], references: [id])
  scheduledStartAt  DateTime?
  scheduledEndAt    DateTime?
  acceptanceDeadline DateTime?
  
  // Join tracking (for no-show detection)
  coachJoinedAt   DateTime?
  studentJoinedAt DateTime?
  
  status          LessonRequestStatus @default(PENDING)
  studentConfirmed Boolean @default(false)
  coachConfirmed   Boolean @default(false)
  disputeReason    String?
  declineReason    String?
  boardPgn         String?
  boardTree        Json?
  
  createdAt   DateTime  @default(now())
  respondedAt DateTime?
  completedAt DateTime?

  // 30-day retention: set when chat + free-text content has been purged.
  dataPurgedAt DateTime?

  // Reminder email bookkeeping (scheduled lessons only). Set when the matching
  // reminder has been sent so the sweep never double-sends.
  reminderDayBeforeSentAt  DateTime?
  reminderHourBeforeSentAt DateTime?

  reviews      Review[]
  transactions Transaction[]
  abuseFlags   AbuseFlag[]
  chatMessages ChatMessage[]
  
  @@index([studentId])
  @@index([coachId])
  @@index([status])
  @@index([timeSlotId])
  @@index([scheduledStartAt])
}

model Transaction {
  id     String   @id @default(cuid())
  
  userId String
  user   User   @relation(fields: [userId], references: [id])
  
  type   TransactionType
  amount Int     // cents (positive = credit, negative = debit)
  
  lessonRequestId String?
  lessonRequest   LessonRequest? @relation(fields: [lessonRequestId], references: [id])
  
  stripePaymentIntentId String? @unique
  
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([type])
}

model Payout {
  id      String   @id @default(cuid())
  
  coachId String
  coach   User   @relation(fields: [coachId], references: [id])
  
  amount  Int     // cents
  status  PayoutStatus @default(PENDING)
  
  stripeTransferId String?
  periodStart      DateTime?
  periodEnd        DateTime?
  
  createdAt DateTime @default(now())
  
  @@index([coachId])
}

// For ELO decay calculation - tracks individual earning events
model EarningRecord {
  id      String   @id @default(cuid())
  
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  
  amount  Int     // cents
  earnedAt DateTime @default(now())
  
  @@index([userId])
  @@index([earnedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  adminId   String
  action    String   // e.g. "VERIFY_USER", "REJECT_USER", "BAN_USER", "SET_ROLE"
  targetId  String   // userId that was acted upon
  details   String?  // optional extra context
  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([targetId])
  @@index([createdAt])
}

model CardFingerprint {
  id          String   @id @default(cuid())
  fingerprint String   // Stripe card fingerprint
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  last4       String?
  brand       String?
  firstSeenAt DateTime @default(now())

  @@unique([fingerprint, userId])
  @@index([fingerprint])
  @@index([userId])
}

model AbuseFlag {
  id              String            @id @default(cuid())
  userId          String
  user            User              @relation("FlaggedUser", fields: [userId], references: [id])
  type            AbuseFlagType
  severity        AbuseFlagSeverity
  details         String
  relatedLessonId String?
  relatedLesson   LessonRequest?    @relation(fields: [relatedLessonId], references: [id])
  relatedUserId   String?
  relatedUser     User?             @relation("RelatedUser", fields: [relatedUserId], references: [id])
  resolved        Boolean           @default(false)
  resolvedBy      String?
  resolvedAt      DateTime?
  createdAt       DateTime          @default(now())

  @@index([userId])
  @@index([resolved])
  @@index([type])
  @@index([createdAt])
}

model VerificationToken {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String                @unique
  type      VerificationTokenType
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime              @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model RateLimitEntry {
  key       String   @id
  count     Int      @default(1)
  resetAt   DateTime

  @@index([resetAt])
}

model RecoveryRequest {
  id               String   @id @default(cuid())
  username         String   // the username they're trying to recover
  chessComUsername  String?  // chess.com username if they have one
  email            String   // email to contact them
  message          String?  // optional extra info
  resolved         Boolean  @default(false)
  resolvedBy       String?
  resolvedAt       DateTime?
  createdAt        DateTime @default(now())

  @@index([resolved])
  @@index([createdAt])
}

model ContactMessage {
  id         String    @id @default(cuid())
  email      String    // email to reply to
  message    String
  userId     String?   // set when the sender was logged in
  username   String?   // snapshot of the sender's username at submit time
  resolved   Boolean   @default(false)
  resolvedBy String?
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([resolved])
  @@index([createdAt])
}

model Favourite {
  id      String @id @default(cuid())
  
  userId  String
  user    User   @relation("FavouriteUser", fields: [userId], references: [id])
  
  coachId String
  coach   User   @relation("FavouriteCoach", fields: [coachId], references: [id])
  
  createdAt DateTime @default(now())
  
  @@unique([userId, coachId])
  @@index([userId])
  @@index([coachId])
}

// A one-directional "I don't want to interact with this person" record. Used for
// both the coach dashboard's block-a-student action and in-chat blocking. A block
// in EITHER direction freezes their conversation and stops bookings between them;
// only the blocker can lift their own block.
model Block {
  id        String @id @default(cuid())

  blockerId String
  blocker   User   @relation("Blocker", fields: [blockerId], references: [id])

  blockedId String
  blocked   User   @relation("Blocked", fields: [blockedId], references: [id])

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model TimeSlotTemplate {
  id          String @id @default(cuid())
  
  coachId     String
  coach       User   @relation(fields: [coachId], references: [id])
  
  dayOfWeek   Int    // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  startHour   Int    // 0-23
  startMinute Int    // 0 or 30 (slot starts; tiles the hour by LESSON_DURATION_MINUTES)
  
  createdAt   DateTime @default(now())
  
  timeSlots   TimeSlot[]
  
  @@unique([coachId, dayOfWeek, startHour, startMinute])
  @@index([coachId])
}

model TimeSlot {
  id          String         @id @default(cuid())
  
  coachId     String
  coach       User           @relation(fields: [coachId], references: [id])
  
  templateId  String?
  template    TimeSlotTemplate? @relation(fields: [templateId], references: [id])
  
  startTime   DateTime
  endTime     DateTime
  status      TimeSlotStatus @default(AVAILABLE)
  
  createdAt   DateTime @default(now())
  
  lessonRequests LessonRequest[]
  
  @@unique([coachId, startTime])
  @@index([coachId])
  @@index([startTime])
  @@index([status])
}

model ChatMessage {
  id              String   @id @default(cuid())
  
  lessonRequestId String
  lessonRequest   LessonRequest @relation(fields: [lessonRequestId], references: [id])
  
  senderId        String
  sender          User   @relation(fields: [senderId], references: [id])
  
  content         String
  readAt          DateTime?

  createdAt       DateTime @default(now())

  @@index([lessonRequestId])
  @@index([senderId])
  @@index([createdAt])
}

model Notification {
  id        String   @id @default(cuid())

  userId    String
  user      User     @relation(fields: [userId], references: [id])

  type      NotificationType
  title     String
  body      String?
  link      String?  // in-app destination, e.g. "/dashboard" or "/lesson/{id}"

  readAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
}

// Persistent 1:1 direct message thread between any two users. Unlike the lesson
// ChatMessage (tied to a booking, purged after 30 days), these are kept
// indefinitely. Anyone can start a thread with anyone; participants are stored
// canonically (participantAId < participantBId) so there is exactly one thread
// per pair regardless of who initiated. Blocking lives in the Block model.
model Conversation {
  id        String @id @default(cuid())

  participantAId String
  participantA   User   @relation("ConvA", fields: [participantAId], references: [id])

  participantBId String
  participantB   User   @relation("ConvB", fields: [participantBId], references: [id])

  lastMessageAt  DateTime @default(now()) // inbox ordering

  messages  DirectMessage[]

  createdAt DateTime @default(now())

  @@unique([participantAId, participantBId])
  @@index([participantAId])
  @@index([participantBId])
  @@index([lastMessageAt])
}

model DirectMessage {
  id             String       @id @default(cuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  senderId       String
  sender         User         @relation("DMSender", fields: [senderId], references: [id])

  content        String
  readAt         DateTime?

  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@index([senderId])
}

// A hand-curated tactics puzzle. `fen` is the position the solver starts from and
// `solution` is the line from there in SAN: even indices are the moves the solver
// has to find, odd indices are the opponent replies we auto-play. Both are derived
// by the admin form from `sourcePgn` plus a solution length, so a puzzle can run
// several moves deep instead of being a single tactic shot.
model Puzzle {
  id         String @id @default(cuid())
  slug       String @unique

  // 1-5 stars. Every tier is playable from the start (a strong solver should not
  // have to grind 1-star puzzles first); `orderIndex` is the position inside the
  // tier, and puzzle N+1 only unlocks once N is solved.
  difficulty Int
  orderIndex Int

  // The position the solver faces, i.e. after `setupMove` has been played.
  fen        String
  solution   String[]
  // "w" or "b": the side the solver plays. Also the board orientation, so the
  // solver always sits at the bottom of the board.
  sideToMove String

  // The opponent's move immediately before the puzzle, played automatically on
  // load from `setupFen` so the solver watches the position arrive instead of
  // being dropped into it cold. Null only when the puzzle starts at ply 1.
  setupFen   String?
  setupMove  String?

  title      String?
  theme      String?
  sourcePgn  String?

  published  Boolean @default(false)

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  solves     PuzzleSolve[]

  // Not unique on [difficulty, orderIndex]: reordering swaps positions, and a
  // unique constraint would reject the intermediate state mid-swap.
  @@index([difficulty, orderIndex])
  @@index([published])
}

// One row per user per solved puzzle. Absence means unsolved, so the ladder only
// needs the set of puzzle ids this user has cleared. Guests accumulate the same
// ids in sessionStorage and merge them here if they sign up before leaving.
model PuzzleSolve {
  id       String @id @default(cuid())

  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  puzzleId String
  puzzle   Puzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  // How many wrong tries before it fell. 1 means first attempt.
  attempts Int      @default(1)
  solvedAt DateTime @default(now())

  @@unique([userId, puzzleId])
  @@index([userId])
  @@index([puzzleId])
}

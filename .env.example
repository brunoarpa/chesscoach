# --- App ---
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-openssl-rand-base64-32

# --- Database ---
DATABASE_URL=postgresql://user:pass@localhost:5432/chesscoach

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (SendGrid) ---
# Get from https://app.sendgrid.com/settings/api_keys (needs "Mail Send" permission)
SENDGRID_API_KEY=
# Must be a verified sender in your SendGrid account
EMAIL_FROM=noreply@yourdomain.com

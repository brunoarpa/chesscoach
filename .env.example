# --- App ---
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-openssl-rand-base64-32
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://user:pass@localhost:5432/elochaser

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (SendGrid) ---
# Get from https://app.sendgrid.com/settings/api_keys (needs "Mail Send" permission)
SENDGRID_API_KEY=
# Must be a verified sender in your SendGrid account
EMAIL_FROM=noreply@elochaser.com

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Pusher (real-time) ---
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# --- WebRTC TURN (video calls) ---
NEXT_PUBLIC_TURN_URL=
NEXT_PUBLIC_TURN_USERNAME=
NEXT_PUBLIC_TURN_CREDENTIAL=

# --- Cron ---
# Random secret used to authenticate /api/cron/daily requests
CRON_SECRET=

# --- App ---
AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-openssl-rand-base64-32
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). Leave blank to
# disable analytics in local/dev; set it in production only.
NEXT_PUBLIC_GA_ID=

# --- Database ---
DATABASE_URL=postgresql://user:pass@localhost:5432/elochaser

# --- Google OAuth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (SendGrid) ---
# Get from https://app.sendgrid.com/settings/api_keys (needs "Mail Send" permission)
SENDGRID_API_KEY=
# Must be a verified sender in your SendGrid account
EMAIL_FROM=noreply@elochaser.com

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Pusher (real-time) ---
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# --- WebRTC TURN (audio calls) ---
# Served to clients via /api/turn (auth required); never use NEXT_PUBLIC_ here,
# that would inline the credentials into the public JS bundle.
TURN_URL=
# Preferred: coturn `use-auth-secret` shared secret for ephemeral credentials.
TURN_SECRET=
# Fallback: static credentials (only if your TURN server can't do auth-secret).
TURN_USERNAME=
TURN_CREDENTIAL=

# --- Cron ---
# Random secret used to authenticate /api/cron/daily requests
CRON_SECRET=

# --- Sentry (error monitoring) ---
# Both from sentry.io -> your project -> Settings -> Client Keys (DSN).
# Leave empty to disable monitoring entirely (e.g. local dev).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
